{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "preserveSymlinks": true,
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "allowImportingTsExtensions": true
   },
   "include": ["src/**/*.ts", "vite.config.ts"]
}
