{
   "name": "@vault/sdk",
   "version": "0.1.0",
   "license": "CC-BY-NC-4.0",
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
