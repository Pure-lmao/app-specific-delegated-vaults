{
   "name": "@ASDV/sdk",
   "version": "0.1.0",
   "license": "CC-BY-NC-4.0",
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js",
         "default": "./dist/index.js"
      },
      "./src/*": "./src/*"
   },
   "files": [
      "dist",
      "src"
   ],
   "scripts": {
      "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('dist', { recursive: true }); } catch {}\"",
      "check": "tsc --noEmit",
      "build": "npm run clean && tsc -p tsconfig.build.json",
      "prepack": "npm run build"
   },
   "dependencies": {
      "@solana/kit": "^6.8.0"
   },
   "devDependencies": {
      "typescript": "^5.7.2"
   }
}
